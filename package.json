{
  "name": "spaceadom",
  "private": true,
  "version": "1.0.129",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --outDir dist2",
    "preview": "vite preview",
    "tauri": "tauri",
    "posttauri": "node scripts/archive-build.mjs",
    "store": "tauri build --config src-tauri/tauri.store.conf.json",
    "arm64": "tauri build --target aarch64-pc-windows-msvc",
    "poststore": "node scripts/label-store-build.mjs",
    "msix": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-msix.ps1",
    "msix:arm64": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-msix.ps1 -Arch arm64",
    "portable": "node scripts/build-portable.mjs",
    "test:own-window-keys": "node scripts/own-window-keys.test.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "vite": "^6.0.3",
    "typescript": "~5.6.2"
  }
}
