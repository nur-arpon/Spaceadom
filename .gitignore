# ---------------------------------------------------------------------------
# Build output — regenerated by `npm run tauri build`, never committed.
# src-tauri/target alone is 4.6 GB.
# ---------------------------------------------------------------------------
node_modules/
dist/
dist2/
dist-stale/
src-tauri/target/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Installers. 342 MB and growing ~11 MB per build — far past what belongs in a
# git repo, and GitHub rejects single files over 100 MB anyway.
# These live in GitHub RELEASES instead (see .github/workflows/release.yml),
# which is the right home for binaries: versioned, downloadable, not cloned.
# `all-versions/` stays on your machine as the local archive.
# ---------------------------------------------------------------------------
all-versions/
# ...but DO publish the changelog that lives in it. People should be able to
# read what changed in each version without downloading anything.
!all-versions/
all-versions/*
!all-versions/WHAT-CHANGED.md
share-spaceadom/
*.msi
*.exe
!src-tauri/icons/*.exe

# ---------------------------------------------------------------------------
# PERSONAL DATA — MUST NEVER BE PUBLISHED.
#
# These are recovered copies of the developer's own config.json. They contain
# absolute paths including the Windows username (C:\Users\<name>\...), the
# exact applications installed, and base64 icons taken from them. Harmless on
# one machine; a privacy leak in a public repository.
# ---------------------------------------------------------------------------
_config-rescue/
_recovered/
_REAL-CONFIG-BACKUP.json
_safety-config.json
_config-before-*.json
_config-wiped-*.json
_config-live-copy.json
# …and every dated variant of it. 1.0.95: `_config-live-copy-1029-preinstall.json`
# sat un-ignored beside the plain name for three releases — a bare filename in
# this list only ever covers the ONE copy somebody happened to make. Glob it.
_config-live-copy-*.json
config.json
config.json.*
# postinstall-probe.ps1 copies the LIVE config to this exact name on every
# install, so it is regenerated constantly and carries the full personal
# binding set. Same class as the copies above; added 1.0.95.
config-copy.json
# Scratch directory for one-off probe output (exe reads, marker scans, config
# excerpts). Everything in it is a measurement of the owner's machine.
_probe/

# scripts/config-check.cmd copies the LIVE config out through explorer.exe (the
# only way to read the real file — see CLAUDE.md on the config.json shadow) and
# writes its findings, log excerpts included, beside it. Both carry the same
# personal data as the recovered copies above. Added 1.0.88, when the copy
# landed on an un-ignored name and nearly got committed.
config-check.txt
preinstall-probe.txt
postinstall-probe.txt

# ---------------------------------------------------------------------------
# Scratch output from diagnostic scripts. Transient by nature.
# ---------------------------------------------------------------------------
_*.txt
*.log
debug.log*

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.tmp
*.md.tmp

# ---------------------------------------------------------------------------
# The developer guide. It is deliberately NOT published: its screenshots show
# the Windows username, the personal folder tree, and the exact set of apps
# bound to each key. Keep it, share it deliberately, but do not let a
# `git add -A` push it to a public repository by accident.
# ---------------------------------------------------------------------------
Spaceadom-Developer-Guide.docx
Spaceadom-Developer-Guide.pdf

# PROBLEM 131 - staged debug symbols are a build output (8.5 MB), not source.
# scripts/stage-symbols.mjs regenerates them on every build.
src-tauri/symbols/

# Written by scripts/install-real.cmd on every install — a proof file,
# not source.
install-check.txt
install-proof.txt

# PROBLEM 196 - the real Sentry DSN. Safe to ship IN THE BUILT APP (a DSN
# can only submit events, never read the account), but not safe to publish
# in git history - see src-tauri/src/sentry_dsn.example.txt for setup.
src-tauri/src/sentry_dsn.txt
