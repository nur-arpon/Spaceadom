{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "SpaceToggle OS default capabilities — settings window AND the HUD overlay. The overlay MUST be listed here: without it the overlay webview has no core:event permission, listen() rejects silently, and the HUD renders as an empty dark box (root cause found 2026-08-10 after chasing emit targets, paint order and CSP).",
  "local": true,
  "windows": ["settings", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-is-visible",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:app:allow-version",
    "core:tray:allow-set-icon",
    "core:tray:allow-set-tooltip",
    "core:tray:allow-set-visible",
    "notification:default",
    "notification:allow-request-permission",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "shell:allow-execute",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-ask",
    "opener:default"
  ]
}
