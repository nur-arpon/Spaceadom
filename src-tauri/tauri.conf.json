{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spaceadom",
  "version": "1.0.65",
  "identifier": "com.spaceadom.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/stage-symbols.mjs --real",
    "frontendDist": "../dist2"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Spaceadom",
        "width": 1220,
        "height": 880,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true,
        "skipTaskbar": false,
        "theme": "Light"
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Spaceadom Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "visible": false,
        "width": 600,
        "height": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "symbols/spaceadom.pdb": "spaceadom.pdb"
    },
    "externalBin": [],
    "copyright": "\u00a9 2026 Spaceadom",
    "category": "Utility",
    "shortDescription": "Hold Space + tap a key to launch, focus or minimise any app.",
    "longDescription": "Spaceadom turns your Spacebar into a system-wide modifier: hold Space and tap a key to launch, focus or minimise any app or website. Space alone still types a space.",
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "tsp": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "7A2C4E19-8B3D-4F6A-9C1E-5D8F2B7A4C63",
        "template": "wix/main.wxs"
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "publisher": "Spaceadom"
  }
}
