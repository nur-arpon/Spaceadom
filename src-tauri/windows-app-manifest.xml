<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3"
          manifestVersion="1.0">

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <!-- PROBLEM 61. asInvoker, NEVER requireAdministrator.
             WH_KEYBOARD_LL does not need elevation. Requiring it meant a UAC
             prompt on every launch, autostart that silently failed on standard
             (non-admin) accounts, and a tester who had to "Run as
             administrator" to get the app up at all. It also makes a global
             keyboard hook that auto-elevates at logon look exactly like a
             keylogger to AV heuristics.
             KNOWN, ACCEPTED LIMITATION: a non-elevated hook receives no input
             while an ELEVATED window has focus (Task Manager, regedit, an admin
             terminal, the UAC secure desktop). That is Windows UIPI and applies
             to every remapper. Documented, not worked around. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <asmv3:application>
    <asmv3:windowsSettings>
      <!-- PROBLEM 62 — DPI. Without these the process is DPI-UNAWARE and
           Windows feeds it virtualised coordinates, so every monitor/window
           calculation is silently wrong on scaled displays. The tester runs
           1280x720 @150%; the dev machine has a 100% and a 150% monitor. -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <!-- Users with long or non-ASCII paths. Costs nothing. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </asmv3:windowsSettings>
  </asmv3:application>

  <!-- MUST NOT BE OMITTED. Supplying app_manifest() REPLACES Tauri's default
       manifest wholesale, and that default declares Common-Controls v6. Without
       this block the binary fails to start at all with exit code 0xC0000139
       STATUS_ENTRYPOINT_NOT_FOUND, because comctl32 v5 is loaded and the v6
       exports the toolkit imports are missing. Verified: the build without this
       would not launch; with it, it does. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Win10/11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- 8.1 -->
    </application>
  </compatibility>
</assembly>
